# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Dipakai untuk link absolut di notifikasi WhatsApp dan redirect email.
NEXT_PUBLIC_SITE_URL=https://<domain-publish>

# Proteksi endpoint cron /api/cron/*.
CRON_SECRET=<random-string-panjang>

# Template renewal (pesan business-initiated harus memakai template Meta).
META_WA_TEMPLATE_RENEWAL=renewal_reminder_v1

# Meta WhatsApp Cloud API (invoice & notifikasi servis).
META_WA_ACCESS_TOKEN=<meta-system-user-token>
META_WA_PHONE_NUMBER_ID=1443653698834770 # fallback; bisa dioverride per tenant di /owner/tenants/[id]
# Template kustom (nama harus persis seperti di Meta Business Manager)
META_WA_TEMPLATE_SERVIS_MASUK=servis_masuk_v2
META_WA_TEMPLATE_SHIFT_OPEN=shift_open_v1
META_WA_TEMPLATE_SHIFT_CLOSE=shift_close_v1
# Template servis lain memakai env lama langsung
META_WA_TEMPLATE_INVOICE=servis_invoice_customer_v1
META_WA_TEMPLATE_STATUS=servis_status_customer_v1
META_WA_TEMPLATE_TECHNICIAN=servis_baru_teknisi_v1

# Nomor WhatsApp owner platform untuk pesan darurat/notifikasi internal.
OWNER_WHATSAPP_NUMBER=628xxxxxxxxxx

# Webhook delivery status Meta (sumber kebenaran status kirim & refund kuota).
# Daftarkan URL https://<domain>/api/webhooks/meta-wa di Meta App Dashboard.
WHATSAPP_WEBHOOK_SECRET=<meta-app-secret>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<random-string-panjang>

# Pembayaran: Duitku sengaja TIDAK dikonfigurasi sampai merchant disetujui.
# Jangan isi kredensial duplikat / sandbox palsu. Transfer manual satu-satunya provider aktif.
# DUITKU_MERCHANT_CODE=
# DUITKU_API_KEY=
