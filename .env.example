# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Dipakai untuk link absolut di notifikasi WhatsApp dan redirect email.
NEXT_PUBLIC_SITE_URL=https://<domain-publish>

# Proteksi endpoint cron /api/cron/*.
CRON_SECRET=<random-string-panjang>

# Fonnte (notifikasi WhatsApp).
FONNTE_TOKEN=<fonnte-token>

# Nomor WhatsApp owner platform untuk pesan darurat/notifikasi internal.
OWNER_WHATSAPP_NUMBER=628xxxxxxxxxx
