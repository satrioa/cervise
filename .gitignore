# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lockfile package manager lain - repo ini pakai npm, yang lockfile-nya
# package-lock.json. Dua lockfile berarti resolusi versi bisa berbeda antar
# mesin, dan bugnya cuma muncul di orang yang memakai manager yang lain.
# File ini muncul kalau ada yang menjalankan `bun install` tanpa disadari.
bun.lock
bun.lockb
pnpm-lock.yaml
pnpm-workspace.yaml

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.originkit/

# supabase cli local state
/supabase/.temp/

# Id baris hasil seed demo - regenerated tiap kali seed dijalankan
supabase/.seed-ids.json
